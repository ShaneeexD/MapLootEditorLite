<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Client\BotGenRegistryTransport.cs" Link="BotGenRegistryTransport.cs" />
    <Compile Include="..\..\Client\NpcProviders.cs" Link="NpcProviders.cs" />
    <Compile Include="..\..\Server\PackData.cs" Link="PackData.cs" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateTestReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SPTPath)\EscapeFromTarkov_Data\Managed\Newtonsoft.Json.dll')"
           Text="Pass -p:SPTPath=&lt;SPT game directory&gt; to use the installed Newtonsoft.Json assembly." />
  </Target>
</Project>
